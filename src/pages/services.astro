---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <section class="max-w-2xl mx-auto py-12">
        <h2 class="text-3xl font-semibold mb-8 text-center">Services</h2>

        <div class="space-y-6">
            <div>
                <h3 class="text-xl font-medium mb-2">Lash Extensions</h3>
                <p class="text-neutral-600">
                    Classic, hybrid, and volume sets. Fills available.
                </p>
            </div>

            <div>
                <h3 class="text-xl font-medium mb-2">Brow Services</h3>
                <p class="text-neutral-600">
                    Brow lamination, tinting, and shaping.
                </p>
            </div>

            <div>
                <h3 class="text-xl font-medium mb-2">Facials</h3>
                <p class="text-neutral-600">
                    Customized facial treatments for all skin types.
                </p>
            </div>

            <div>
                <h3 class="text-xl font-medium mb-2">Waxing</h3>
                <p class="text-neutral-600">Full body waxing services.</p>
            </div>
        </div>

        <div class="mt-12 text-center">
            <a
                href="https://book.squareup.com/appointments/k96s305aovu0gi/location/LNSS8MG6VB42H/services"
                target="_blank"
                rel="noopener noreferrer"
                class="bg-brand-muted text-white px-8 py-3 rounded hover:bg-brand-dark transition-colors inline-block"
            >
                Book Now
            </a>
            <p class="text-sm text-neutral-500 mt-2">
                View full pricing and availability on Square
            </p>
        </div>
    </section>
</Layout>
