---
import Layout from "../layouts/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { services, categories, BOOKING_URL } from "../data/services";

const pageTitle = "Esthetics Services in Edmonton | Lashes, Brows, Facials, Waxing | True Beauty Esthetics";
const pageDescription = "Browse our full service menu — lash extensions, lash lifts, brow lamination, facials, teeth whitening, and waxing — at our South Edmonton studio on Calgary Trail.";
---

<Layout title={pageTitle} description={pageDescription}>
    <section
        class="grid grid-cols-1 md:grid-cols-2 gap-8 px-4 py-6 mx-auto w-full max-w-7xl md:min-h-[calc(100dvh-var(--header-h,0)-var(--footer-h,0)-2rem)]"
    >
        <!-- Left: header + filters -->
        <div class="flex flex-col gap-6 md:pr-4 md:pt-4">
            <div>
                <h1 class="text-4xl md:text-5xl font-light mb-3 fade-in-up">
                    our services
                </h1>
                <p class="text-neutral-300 text-base md:text-lg fade-in-up stagger-2">
                    Expert esthetic services tailored to enhance your natural
                    beauty. From lashes to facials, we've got you covered.
                </p>
            </div>

            <a
                href={BOOKING_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary fade-in-up stagger-3 self-start"
            >
                Book Your Appointment
            </a>

            <div class="fade-in-up stagger-4">
                <p class="text-xs text-neutral-500 uppercase tracking-wide mb-3">
                    Filter by category
                </p>
                <div class="flex flex-wrap gap-2">
                    {
                        categories.map((cat) => (
                            <button
                                class="filter-btn px-4 py-1.5 rounded-full border-2 transition-all duration-300 font-medium text-sm"
                                data-category={cat.toLowerCase()}
                            >
                                {cat}
                            </button>
                        ))
                    }
                </div>
            </div>
        </div>

        <!-- Right: scrollable services grid -->
        <div
            class="flex flex-col min-h-0 md:max-h-[calc(100dvh-var(--header-h,0)-var(--footer-h,0)-4rem)]"
        >
            <div
                class="grid grid-cols-1 xl:grid-cols-2 gap-4 overflow-y-auto pr-2 services-scroll"
                id="services-grid"
            >
                {
                    services.map((service) => (
                        <ServiceCard
                            slug={service.slug}
                            title={service.title}
                            description={service.description}
                            price={service.price}
                            duration={service.duration}
                            category={service.category}
                        />
                    ))
                }
            </div>
        </div>
    </section>
</Layout>

<script>
    const filterButtons = document.querySelectorAll(".filter-btn");
    const serviceCards = document.querySelectorAll(".service-card");

    filterButtons[0]?.classList.add("active");

    filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
            const category = button.getAttribute("data-category");

            filterButtons.forEach((btn) => btn.classList.remove("active"));
            button.classList.add("active");

            serviceCards.forEach((card) => {
                const cardCategory = card.getAttribute("data-category");
                if (category === "all" || cardCategory === category) {
                    card.classList.remove("hidden");
                    (card as HTMLElement).style.animation = "fadeInUp 0.5s ease-out";
                } else {
                    card.classList.add("hidden");
                }
            });
        });
    });
</script>

<style>
    .filter-btn {
        border-color: #404040;
        color: #9ca3af;
        background: transparent;
    }

    .filter-btn:hover {
        border-color: #3da562;
        color: #3da562;
        background: rgba(45, 138, 78, 0.1);
    }

    .filter-btn.active {
        border-color: #2d8a4e;
        background: #2d8a4e;
        color: white;
    }

    .hidden {
        display: none;
    }

    .services-scroll {
        scrollbar-width: thin;
        scrollbar-color: #404040 transparent;
    }

    .services-scroll::-webkit-scrollbar {
        width: 6px;
    }

    .services-scroll::-webkit-scrollbar-track {
        background: transparent;
    }

    .services-scroll::-webkit-scrollbar-thumb {
        background: #404040;
        border-radius: 3px;
    }

    .services-scroll::-webkit-scrollbar-thumb:hover {
        background: #525252;
    }
</style>
