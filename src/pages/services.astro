---
import Layout from "../layouts/Layout.astro";
import { Content } from "../content/services.mdx";
---

<Layout>
    <section class="max-w-2xl mx-auto py-12">
        <div class="text-center mb-8">
            <a
                href="https://book.squareup.com/appointments/k96s305aovu0gi/location/LNSS8MG6VB42H/services"
                target="_blank"
                rel="noopener noreferrer"
                class="bg-brand-muted text-white px-8 py-3 rounded hover:bg-brand-dark transition-colors inline-block"
            >
                Book Now
            </a>
        </div>

        <div class="services-content">
            <Content />
        </div>
    </section>
</Layout>

<style>
    @reference "../styles/global.css";

    .services-content :global(h1) {
        @apply text-3xl font-semibold mb-12 text-center;
    }
    .services-content :global(h2) {
        @apply text-2xl font-semibold mb-6 mt-12 pb-2 border-b border-neutral-700;
    }
    .services-content :global(h3) {
        @apply text-lg font-medium mt-8 mb-2 text-brand-light;
    }
    .services-content :global(p) {
        @apply text-neutral-400 text-sm mb-1;
    }
    .services-content :global(p strong) {
        @apply text-white font-semibold;
    }
    .services-content :global(p em) {
        @apply text-neutral-500 text-xs;
    }
    .services-content :global(hr) {
        @apply my-12 border-neutral-800;
    }
</style>
