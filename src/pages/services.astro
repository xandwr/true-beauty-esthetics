---

<Layout>
    <section class="max-w-7xl mx-auto py-12 px-4">
        <div class="text-center mb-12">
            <h1 class="text-5xl font-light mb-4 fade-in-up">
                our services
            </h1>
            <p class="text-neutral-300 text-lg mb-8 max-w-2xl mx-auto fade-in-up stagger-2">
                Expert esthetic services tailored to enhance your natural beauty.
                From lashes to facials, we've got you covered.
            </p>
            <a
                href="https://book.squareup.com/appointments/k96s305aovu0gi/location/LNSS8MG6VB42H/services"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary fade-in-up stagger-3"
            >
                Book Your Appointment
            </a>
        </div>

        <!-- Category Filter -->
        <div class="flex flex-wrap justify-center gap-3 mb-12 fade-in-up stagger-4">
            {
                categories.map((cat) => (
                    <button
                        class="filter-btn px-6 py-2 rounded-full border-2 transition-all duration-300 font-medium"
                        data-category={cat.toLowerCase()}
                    >
                        {cat}
                    </button>
                ))
            }
        </div>

        <!-- Services Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="services-grid">
            {
                services.map((service) => (
                    <ServiceCard
                        title={service.title}
                        description={service.description}
                        price={service.price}
                        duration={service.duration}
                        category={service.category}
                    />
                ))
            }
        </div>
    </section>
</Layout>

<script>
    // Category filtering logic
    const filterButtons = document.querySelectorAll(".filter-btn");
    const serviceCards = document.querySelectorAll(".service-card");

    // Set initial active state
    filterButtons[0]?.classList.add("active");

    filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
            const category = button.getAttribute("data-category");

            // Update active button
            filterButtons.forEach((btn) => btn.classList.remove("active"));
            button.classList.add("active");

            // Filter cards
            serviceCards.forEach((card) => {
                const cardCategory = card.getAttribute("data-category");
                if (category === "all" || cardCategory === category) {
                    card.classList.remove("hidden");
                    (card as HTMLElement).style.animation = "fadeInUp 0.5s ease-out";
                } else {
                    card.classList.add("hidden");
                }
            });
        });
    });
</script>

<style>
    .filter-btn {
        border-color: #404040;
        color: #9ca3af;
        background: transparent;
    }

    .filter-btn:hover {
        border-color: #3da562;
        color: #3da562;
        background: rgba(45, 138, 78, 0.1);
    }

    .filter-btn.active {
        border-color: #2d8a4e;
        background: #2d8a4e;
        color: white;
    }

    .hidden {
        display: none;
    }
</style>
