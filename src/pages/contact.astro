---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <section
        class="flex flex-col mx-auto w-full max-w-6xl px-4 py-6 md:min-h-[calc(100dvh-var(--header-h,0px)-var(--footer-h,0px)-2rem)]"
    >
        <header class="text-center mb-6">
            <h2 class="text-3xl md:text-4xl font-light mb-2">Get in Touch</h2>
            <p class="text-neutral-400 text-sm md:text-base">
                Book an appointment or ask us anything.
            </p>
        </header>

        <div class="grid gap-6 md:grid-cols-2 flex-1 min-h-0">
            <!-- Left: contact details + CTA -->
            <div class="flex flex-col justify-between gap-6">
                <ul class="flex flex-col gap-4 h-full">
                    <li class="h-full">
                        <a
                            href="tel:+15874014806"
                            class="h-full group flex items-center gap-4 p-4 rounded-xl bg-neutral-900/50 border border-neutral-800 hover:border-brand-muted hover:bg-neutral-900 transition-all"
                        >
                            <span
                                class="shrink-0 w-10 h-10 rounded-full bg-brand-muted/20 flex items-center justify-center group-hover:bg-brand-muted/30 transition-colors"
                            >
                                <svg
                                    class="w-5 h-5 text-brand-light"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1.5"
                                        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                    />
                                </svg>
                            </span>
                            <span class="flex flex-col min-w-0">
                                <span class="text-xs text-neutral-500 uppercase tracking-wide">Phone</span>
                                <span class="text-white group-hover:text-brand-light transition-colors">+1 (587) 401-4806</span>
                            </span>
                        </a>
                    </li>

                    <li class="h-full">
                        <a
                            href="mailto:truebeautyesthetics@outlook.com"
                            class="h-full group flex items-center gap-4 p-4 rounded-xl bg-neutral-900/50 border border-neutral-800 hover:border-brand-muted hover:bg-neutral-900 transition-all"
                        >
                            <span
                                class="shrink-0 w-10 h-10 rounded-full bg-brand-muted/20 flex items-center justify-center group-hover:bg-brand-muted/30 transition-colors"
                            >
                                <svg
                                    class="w-5 h-5 text-brand-light"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1.5"
                                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                    />
                                </svg>
                            </span>
                            <span class="flex flex-col min-w-0">
                                <span class="text-xs text-neutral-500 uppercase tracking-wide">Email</span>
                                <span class="text-white group-hover:text-brand-light transition-colors truncate">truebeautyesthetics@outlook.com</span>
                            </span>
                        </a>
                    </li>

                    <li class="h-full">
                        <div
                            class="h-full flex items-center gap-4 p-4 rounded-xl bg-neutral-900/50 border border-neutral-800"
                        >
                            <span
                                class="shrink-0 w-10 h-10 rounded-full bg-brand-muted/20 flex items-center justify-center"
                            >
                                <svg
                                    class="w-5 h-5 text-brand-light"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1.5"
                                        d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                                    />
                                </svg>
                            </span>
                            <span class="flex flex-col min-w-0">
                                <span class="text-xs text-neutral-500 uppercase tracking-wide">Hours</span>
                                <span class="text-white">Mon – Fri, 9:00 AM – 7:00 PM</span>
                            </span>
                        </div>
                    </li>

                    <li class="h-full">
                        <a
                            href="https://maps.google.com/?q=5720+Calgary+Trail+NW,+Edmonton,+AB+T6H+2K2"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="h-full group flex items-center gap-4 p-4 rounded-xl bg-neutral-900/50 border border-neutral-800 hover:border-brand-muted hover:bg-neutral-900 transition-all"
                        >
                            <span
                                class="shrink-0 w-10 h-10 rounded-full bg-brand-muted/20 flex items-center justify-center group-hover:bg-brand-muted/30 transition-colors"
                            >
                                <svg
                                    class="w-5 h-5 text-brand-light"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1.5"
                                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                    />
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1.5"
                                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                    />
                                </svg>
                            </span>
                            <span class="flex flex-col min-w-0">
                                <span class="text-xs text-neutral-500 uppercase tracking-wide">Location</span>
                                <span class="text-white group-hover:text-brand-light transition-colors">5720 Calgary Trail NW, Edmonton, AB T6H 2K2</span>
                            </span>
                        </a>
                    </li>
                </ul>

                <a
                    href="https://book.squareup.com/appointments/k96s305aovu0gi/location/LNSS8MG6VB42H/services"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="bg-brand-muted text-white text-center px-6 py-4 rounded-lg hover:bg-brand-dark transition-colors text-lg font-medium"
                >
                    Book an Appointment
                </a>
            </div>

            <!-- Right: map -->
            <div
                class="rounded-xl overflow-hidden border border-neutral-800 min-h-[20rem] md:min-h-0"
            >
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2372.896!2d-113.4978!3d53.4683!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x53a0220c98e1!2s5720+Calgary+Trail+NW%2C+Edmonton%2C+AB+T6H+2K2!5e0!3m2!1sen!2sca!4v1"
                    width="100%"
                    height="100%"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title="True Beauty Esthetics Location"></iframe>
            </div>
        </div>
    </section>
</Layout>
