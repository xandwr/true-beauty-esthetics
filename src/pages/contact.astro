---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <section class="max-w-4xl mx-auto py-12 px-4">
        <h2 class="text-4xl font-light mb-4 text-center">Get in Touch</h2>
        <p class="text-neutral-400 text-center mb-12 max-w-md mx-auto">
            We'd love to hear from you. Reach out to book an appointment or ask any questions.
        </p>

        <div class="grid gap-6 mb-10">
            <!-- Phone -->
            <a
                href="tel:+15874014806"
                class="group p-2 rounded-xl bg-neutral-900/50 border border-neutral-800 hover:border-brand-muted hover:bg-neutral-900 transition-all text-center"
            >
                <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-brand-muted/20 flex items-center justify-center group-hover:bg-brand-muted/30 transition-colors">
                    <svg class="w-6 h-6 text-brand-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                </div>
                <h3 class="font-medium text-white mb-1">Phone</h3>
                <p class="text-neutral-400 text-sm group-hover:text-brand-light transition-colors">+1 587-401-4806</p>
            </a>

            <!-- Email -->
            <a
                href="mailto:truebeautyesthetics@outlook.com"
                class="group p-2 rounded-xl bg-neutral-900/50 border border-neutral-800 hover:border-brand-muted hover:bg-neutral-900 transition-all text-center"
            >
                <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-brand-muted/20 flex items-center justify-center group-hover:bg-brand-muted/30 transition-colors">
                    <svg class="w-6 h-6 text-brand-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                </div>
                <h3 class="font-medium text-white mb-1">Email</h3>
                <p class="text-neutral-400 text-sm group-hover:text-brand-light transition-colors break-all">truebeautyesthetics@outlook.com</p>
            </a>

            <!-- Hours -->
            <div class="p-2 rounded-xl bg-neutral-900/50 border border-neutral-800 text-center">
                <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-brand-muted/20 flex items-center justify-center">
                    <svg class="w-6 h-6 text-brand-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <h3 class="font-medium text-white mb-1">Hours</h3>
                <p class="text-neutral-400 text-sm">Open until 7:00 p.m.</p>
            </div>

            <!-- Address -->
            <a
                href="https://maps.google.com/?q=5720+Calgary+Trail+NW,+Edmonton,+AB+T6H+2K2"
                target="_blank"
                rel="noopener noreferrer"
                class="group p-2 rounded-xl bg-neutral-900/50 border border-neutral-800 hover:border-brand-muted hover:bg-neutral-900 transition-all text-center"
            >
                <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-brand-muted/20 flex items-center justify-center group-hover:bg-brand-muted/30 transition-colors">
                    <svg class="w-6 h-6 text-brand-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </div>
                <h3 class="font-medium text-white mb-1">Location</h3>
                <p class="text-neutral-400 text-sm group-hover:text-brand-light transition-colors">5720 Calgary Trail NW<br />Edmonton, AB T6H 2K2</p>
            </a>
        </div>

        <!-- Map -->
        <div class="w-full h-80 rounded-xl overflow-hidden border border-neutral-800 mb-12">
            <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2372.896!2d-113.4978!3d53.4683!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x53a0220c98e1!2s5720+Calgary+Trail+NW%2C+Edmonton%2C+AB+T6H+2K2!5e0!3m2!1sen!2sca!4v1"
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="True Beauty Esthetics Location"></iframe>
        </div>

        <!-- CTA -->
        <div class="text-center">
            <a
                href="https://book.squareup.com/appointments/k96s305aovu0gi/location/LNSS8MG6VB42H/services"
                target="_blank"
                rel="noopener noreferrer"
                class="bg-brand-muted text-white px-10 py-4 rounded-lg hover:bg-brand-dark transition-colors inline-block text-lg font-medium"
            >
                Book an Appointment
            </a>
        </div>
    </section>
</Layout>
