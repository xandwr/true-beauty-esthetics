---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <section class="max-w-4xl mx-auto py-8">
        <h2 class="text-2xl font-semibold mb-10 text-center">
            Give Us A Visit
        </h2>

        <div class="grid md:grid-cols-1 gap-8">
            <div class="flex flex-wrap md:flex-nowrap justify-between gap-6">
                <div class="text-start">
                    <h3 class="font-semibold text-lg">Address</h3>
                    <p class="text-neutral-600">
                        5720 Calgary Trail NW<br />Edmonton AB T6H 2K2
                    </p>
                </div>

                <div class="text-center">
                    <h3 class="font-semibold text-lg">Hours</h3>
                    <p class="text-neutral-600">Open until 7:00 p.m.</p>
                </div>

                <div class="text-center">
                    <h3 class="font-semibold text-lg">Phone</h3>
                    <a
                        href="tel:+15874014806"
                        class="text-neutral-600 hover:text-brand-muted"
                        >+1 587-401-4806</a
                    >
                </div>

                <div class="text-end">
                    <h3 class="font-semibold text-lg">Email</h3>
                    <a
                        href="mailto:truebeautyesthetics@outlook.com"
                        class="text-neutral-600 hover:text-brand-muted"
                        >truebeautyesthetics@outlook.com</a
                    >
                </div>
            </div>

            <div class="w-full h-80 rounded-lg overflow-hidden shadow-md">
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2372.896!2d-113.4978!3d53.4683!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x53a0220c98e1!2s5720+Calgary+Trail+NW%2C+Edmonton%2C+AB+T6H+2K2!5e0!3m2!1sen!2sca!4v1"
                    width="100%"
                    height="100%"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title="True Beauty Esthetics Location"></iframe>
            </div>
        </div>
    </section>
</Layout>
