---
import Layout from "../layouts/Layout.astro";

// Import all staff MDX files
const staffFiles = import.meta.glob("../content/staff/*.mdx", { eager: true });
const staff = Object.values(staffFiles)
    .map((file: any) => ({
        ...file.frontmatter,
        Content: file.Content,
    }))
    .sort((a, b) => a.order - b.order);
---

<Layout>
    <section class="max-w-4xl mx-auto py-12 px-4">
        <div class="border border-neutral-500/50 mb-10" />

        <!-- Header -->
        <div class="text-center mb-16">
            <span class="flex flex-row gap-x-4 font-light mx-auto w-max text-4xl mb-4">
                <h2 class="">fresh,</h2>
                <h2 class="">natural,</h2>
                <h2 class="">effortless.</h2>
            </span>

            <p class="text-neutral-400 max-w-2xl mx-auto">
                <i>True Beauty Esthetics</i> is Edmonton's destination for professional lash extensions, brow services, facials, and more. We're dedicated to helping you look and feel your best.
            </p>
        </div>

        <!-- CTA -->
        <div class="text-center mb-10">
            <a
                href="https://book.squareup.com/appointments/k96s305aovu0gi/location/LNSS8MG6VB42H/services"
                target="_blank"
                rel="noopener noreferrer"
                class="bg-brand-muted text-white px-10 py-4 rounded-lg hover:bg-brand-dark transition-colors inline-block text-lg font-medium"
            >
                Book an Appointment
            </a>
        </div>

        <div class="border border-neutral-500/50 mb-10" />

        <!-- Meet the Team -->
        <div class="mb-16">
            <h3 class="text-2xl font-light mb-8 text-center">meet the team:</h3>
            <div class="grid gap-8">
                {staff.map((member) => (
                    <div class="group p-6 rounded-xl bg-neutral-900/50 border border-neutral-800 hover:border-brand-muted transition-all">
                        <div class="flex flex-col sm:flex-row gap-6">
                            <div class="w-24 h-24 sm:w-32 sm:h-32 mx-auto sm:mx-0 rounded-full bg-neutral-800 overflow-hidden flex-shrink-0 border-2 border-neutral-700 group-hover:border-brand-muted transition-colors">
                                <img
                                    src={member.image}
                                    alt={member.name}
                                    class="w-full h-full object-cover"
                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                                />
                                <div class="w-full h-full items-center justify-center text-neutral-600 hidden">
                                    <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                    </svg>
                                </div>
                            </div>
                            <div class="text-center sm:text-left">
                                <h4 class="text-xl font-medium text-white mb-1">{member.name}</h4>
                                <p class="text-brand-light text-sm mb-3">{member.role}</p>
                                <div class="text-neutral-400 text-sm leading-relaxed staff-bio">
                                    <member.Content />
                                </div>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>
</Layout>

<style>
    @reference "../styles/global.css";

    .staff-bio :global(p) {
        @apply mb-2 last:mb-0;
    }
</style>
