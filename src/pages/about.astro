---
import Layout from "../layouts/Layout.astro";

const staffFiles = import.meta.glob("../content/staff/*.mdx", { eager: true });
const staff = Object.values(staffFiles)
    .map((file: any) => ({
        ...file.frontmatter,
        Content: file.Content,
    }))
    .sort((a, b) => a.order - b.order);
---

<Layout>
    <section
        class="flex flex-col mx-auto w-full max-w-6xl px-4 py-6 gap-6 md:min-h-[calc(100dvh-var(--header-h,0)-var(--footer-h,0)-2rem)]"
    >
        <!-- Header -->
        <div class="header-section relative text-center overflow-hidden rounded-xl px-8 py-6">
            <div class="absolute inset-0 -z-10 header-bg">
                <img
                    src="/images/tbe_exterior_1.jpeg"
                    alt=""
                    class="w-full h-full object-cover opacity-30 blur-sm"
                />
            </div>

            <span class="flex flex-row gap-x-4 font-bold mx-auto w-max text-xl lg:text-3xl mb-3">
                <h2>fresh,</h2>
                <h2>natural,</h2>
                <h2>effortless.</h2>
            </span>

            <p class="text-neutral-400 max-w-2xl mx-auto text-sm md:text-base mb-4">
                <i>True Beauty Esthetics</i> is Edmonton's destination for professional lash extensions, brow services, facials, and more. We're dedicated to helping you look and feel your best.
            </p>

            <a
                href="https://book.squareup.com/appointments/k96s305aovu0gi/location/LNSS8MG6VB42H/services"
                target="_blank"
                rel="noopener noreferrer"
                class="bg-brand-muted text-white px-8 py-3 rounded-lg hover:bg-brand-dark transition-colors inline-block font-medium"
            >
                Book an Appointment
            </a>
        </div>

        <!-- Meet the Team -->
        <div class="flex flex-col flex-1 min-h-0 gap-4">
            <h3 class="text-2xl font-light text-center">meet the team:</h3>
            <div class="grid gap-6 md:grid-cols-2">
                {staff.map((member) => (
                    <article class="group p-6 rounded-xl bg-neutral-900/50 border border-neutral-800 hover:border-brand-muted transition-all flex flex-col sm:flex-row gap-6">
                        <div class="w-24 h-24 sm:w-28 sm:h-28 mx-auto sm:mx-0 rounded-full bg-neutral-800 overflow-hidden shrink-0 border-2 border-neutral-700 group-hover:border-brand-muted transition-colors">
                            <img
                                src={member.image}
                                alt={member.name}
                                class="w-full h-full object-cover"
                                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                            />
                            <div class="w-full h-full items-center justify-center text-neutral-600 hidden">
                                <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                </svg>
                            </div>
                        </div>
                        <div class="text-center sm:text-left min-w-0">
                            <h4 class="text-xl font-medium text-white mb-1">{member.name}</h4>
                            <p class="text-brand-light text-sm mb-3">{member.role}</p>
                            <div class="text-neutral-400 text-sm leading-relaxed staff-bio">
                                <member.Content />
                            </div>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>
</Layout>

<style>
    @reference "../styles/global.css";

    .header-bg {
        mask-image: linear-gradient(to right, transparent, black 30%, black 85%, transparent);
        -webkit-mask-image: linear-gradient(to right, transparent, black 30%, black 85%, transparent);
    }

    .staff-bio :global(p) {
        @apply mb-2 last:mb-0;
    }
</style>
