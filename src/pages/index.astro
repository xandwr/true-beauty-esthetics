---
import Layout from "../layouts/Layout.astro";
---

<Layout backgroundImage="/images/peony_mural.png" backgroundBlur={10}>
    <section
        class="flex flex-col m-auto items-center justify-center text-center min-h-[60vh] px-8"
    >
        <h2 class="text-4xl md:text-5xl font-light mb-4 text-white">
            Welcome to True Beauty Esthetics
        </h2>
        <p class="text-neutral-200 max-w-xl mb-8 mx-auto">
            Professional esthetic services in Edmonton. Lashes, brows, facials,
            and more.
        </p>
        <a
            href="https://book.squareup.com/appointments/k96s305aovu0gi/location/LNSS8MG6VB42H/services"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-brand-muted text-white px-8 py-3 rounded hover:bg-brand-dark transition-colors"
        >
            Book an Appointment
        </a>
    </section>
</Layout>
