---
import Layout from "../layouts/Layout.astro";
---

<Layout backgroundImage="/images/peony_mural.png" backgroundBlur={10}>
    <section
        class="flex flex-col m-auto items-center justify-center text-center min-h-[60vh] px-8"
    >
        <div class="flex flex-row gap-x-8 text-4xl md:text-9xl ">
            <h2 class="font-light cursive md:translate-y-[-1.33rem]">
                Uncover
            </h2>
            <h2 class="font-light cursive md:translate-y-[-1.33rem]">
                your
            </h2>
            <h2 class="font-light cursive md:translate-y-[-1.33rem]">
                radiance.
            </h2>
        </div>

        <p class="text-neutral-200 max-w-xl mb-8 mx-auto">
            Professional esthetic services in Edmonton. Lashes, brows, facials,
            and more.
        </p>
    </section>
</Layout>
