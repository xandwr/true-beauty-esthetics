---
const testimonials = [
    {
        name: "Sheridan Kira",
        initial: "S",
        avatarBg: "bg-purple-700",
        service: "Eyelash Extensions, Brow Shaping & Tinting",
        rating: 5,
        text: "The team at True Beauty Esthetics is incredibly friendly, knowledgeable, and hygienic. I have used their services for years, from eyelash extensions to eyebrow shaping and tinting, and it was always a positive experience. The best lashes in south Edmonton!!",
        url: "https://maps.app.goo.gl/2pvnmemDzrZCrMu66",
    },
    {
        name: "Carly Pom",
        initial: "C",
        avatarBg: "bg-sky-700",
        service: "Body Waxing",
        rating: 5,
        text: "I recently visited True Beauty Esthetics and had an amazing experience! From the moment I walked in, the atmosphere was so relaxing and welcoming. I was particularly impressed with the quality of their services — everything was top-notch. A special shout-out to Bobbi, who was incredibly kind and professional. She made me feel comfortable and truly cared about my experience. I highly recommend True Beauty Esthetics to anyone looking for high-quality esthetic services!",
        url: "https://maps.app.goo.gl/WDRqqQSjYR6fxrZV8",
    },
    {
        name: "Paige",
        initial: "P",
        avatarBg: "bg-amber-700",
        service: "Returning Client",
        rating: 5,
        text: "I just give Bobbi my money I don't even need to look in the mirror because she slays every time. The studio is always clean, and vibes are on point! 10/10 recommend.",
        url: "https://maps.app.goo.gl/UW2657Ls5sUcWs7m7",
    },
    {
        name: "Hanna",
        initial: "H",
        avatarBg: "bg-teal-700",
        service: "Brow Lamination & Tint",
        rating: 5,
        text: "I got a brow lamination and tint, LOOKS AMAZING! Never had it done before and was a bit nervous, but the whole process was explained step by step and they look so full and natural! Highly recommend.",
        url: "https://maps.app.goo.gl/VyP5tAfNUfmhHwkq8",
    },
];
---

<div class="flex flex-col h-full min-h-0 gap-4">
    <div class="text-center">
        <h2 class="text-2xl md:text-3xl font-light">what our clients say</h2>
        <p class="text-neutral-400 text-sm mt-1">Real reviews from our Edmonton clients on Google.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 flex-1 min-h-0 overflow-y-auto pr-1">
        {
            testimonials.map((testimonial, index) => (
                <article
                    class="testimonial-card bg-neutral-900/50 backdrop-blur-sm border border-neutral-800 rounded-xl p-4 hover:border-brand-muted transition-all duration-300 flex flex-col"
                    style={`animation-delay: ${index * 0.1}s`}
                >
                    <div class="flex items-center gap-3 mb-2">
                        <div
                            class={`w-9 h-9 rounded-full ${testimonial.avatarBg} flex items-center justify-center text-white font-medium text-sm shrink-0`}
                            aria-hidden="true"
                        >
                            {testimonial.initial}
                        </div>
                        <div class="min-w-0">
                            <p class="font-semibold text-white text-sm truncate">
                                {testimonial.name}
                            </p>
                            <p class="text-xs text-neutral-400 truncate">
                                {testimonial.service}
                            </p>
                        </div>
                    </div>

                    <div
                        class="flex gap-0.5 mb-2"
                        aria-label={`${testimonial.rating} out of 5 stars`}
                    >
                        {Array.from({ length: testimonial.rating }).map(() => (
                            <svg
                                class="w-3 h-3 text-accent"
                                fill="currentColor"
                                viewBox="0 0 20 20"
                            >
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                            </svg>
                        ))}
                    </div>

                    <p class="text-neutral-300 text-xs leading-relaxed flex-1 line-clamp-6">
                        "{testimonial.text}"
                    </p>

                    <a
                        href={testimonial.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[11px] text-neutral-500 hover:text-brand-muted transition-colors mt-2 inline-flex items-center gap-1 self-start"
                    >
                        View on Google
                        <svg
                            class="w-3 h-3"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                            />
                        </svg>
                    </a>
                </article>
            ))
        }
    </div>
</div>

<style>
    .testimonial-card {
        opacity: 0;
        animation: fadeInUp 0.6s ease-out forwards;
    }

    .testimonial-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(184, 61, 104, 0.2);
    }
</style>
