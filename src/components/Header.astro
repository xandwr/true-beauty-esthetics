---
import Title from "./Title.astro";

const pathname = Astro.url.pathname;
---

<header class="flex flex-col gap-y-4 border-b-2 p-6 border-neutral-800/20">
    <div class="flex justify-center">
        <Title />
    </div>
    <nav class="flex justify-center gap-x-8 uppercase">
        <a
            href="/"
            class={pathname === "/"
                ? "text-orange-800/66 bg-neutral-200 p-2 rounded-xl"
                : "p-2"}>Home</a
        >
        <a
            href="/about"
            class={pathname === "/about"
                ? "text-orange-800/66 bg-neutral-200 p-2 rounded-xl"
                : "p-2"}>About</a
        >
        <a
            href="/services"
            class={pathname === "/services"
                ? "text-orange-800/66 bg-neutral-200 p-2 rounded-xl"
                : "p-2"}>Services</a
        >
        <a
            href="/contact"
            class={pathname === "/contact"
                ? "text-orange-800/66 bg-neutral-200 p-2 rounded-xl"
                : "p-2"}>Contact</a
        >
    </nav>
</header>
