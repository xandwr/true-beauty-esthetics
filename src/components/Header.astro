---
import Title from "./Title.astro";

const pathname = Astro.url.pathname;
---

<header class="flex flex-col gap-y-4 p-4">
    <div class="flex justify-center">
        <a href="/" aria-label="Home">
            <Title />
        </a>
    </div>
    <nav class="flex justify-center gap-x-2 md:gap-x-8 uppercase">
        <a
            href="/"
            class={pathname === "/"
                ? "text-brand-muted p-2 font-bold"
                : "p-2"}>Home</a
        >
        <a
            href="/about"
            class={pathname === "/about"
                ? "text-brand-muted p-2 font-bold"
                : "p-2"}>About</a
        >
        <a
            href="/services"
            class={pathname === "/services"
                ? "text-brand-muted p-2 font-bold"
                : "p-2"}>Services</a
        >
        <a
            href="/contact"
            class={pathname === "/contact"
                ? "text-brand-muted p-2 font-bold"
                : "p-2"}>Contact</a
        >
    </nav>
</header>
