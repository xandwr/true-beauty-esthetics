---
import Title from "./Title.astro";

const pathname = Astro.url.pathname;
---

<header class="flex flex-col gap-y-4 border-b-2 p-4 border-neutral-800/20">
    <div class="flex justify-center">
        <Title />
    </div>
    <nav class="flex justify-center gap-x-8 uppercase">
        <a
            href="/"
            class={pathname === "/"
                ? "text-brand-muted bg-neutral-100 p-1 rounded-xl shadow shadow-neutral-200 font-bold"
                : "p-1"}>Home</a
        >
        <a
            href="/about"
            class={pathname === "/about"
                ? "text-brand-muted bg-neutral-100 p-1 rounded-xl shadow shadow-neutral-200 font-bold"
                : "p-1"}>About</a
        >
        <a
            href="/services"
            class={pathname === "/services"
                ? "text-brand-muted bg-neutral-100 p-1 rounded-xl shadow shadow-neutral-200 font-bold"
                : "p-1"}>Services</a
        >
        <a
            href="/contact"
            class={pathname === "/contact"
                ? "text-brand-muted bg-neutral-100 p-1 rounded-xl shadow shadow-neutral-200 font-bold"
                : "p-1"}>Contact</a
        >
    </nav>
</header>
