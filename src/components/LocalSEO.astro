---
import { services } from "../data/services";

const offerCatalog = {
    "@type": "OfferCatalog",
    name: "Esthetics Services",
    itemListElement: services.map((s) => ({
        "@type": "Offer",
        itemOffered: {
            "@type": "Service",
            name: s.title,
            serviceType: s.category,
        },
        price: s.priceMin.toFixed(2),
        priceCurrency: "CAD",
        availability: "https://schema.org/InStock",
        url: `https://truebeautyesthetics.ca/services/${s.slug}`,
    })),
};

const businessData = {
    "@context": "https://schema.org",
    "@type": "BeautySalon",
